{
  "manifest_version": 3,
  "name": "reCAPTCHA Solver for Chrome",
  "version": "1.7.0",
  "description": "Automates reCAPTCHA v2 challenges on Google pages through the 2Captcha API.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://2captcha.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.google.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "reCAPTCHA Solver for Chrome"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://*.google.com/*"
      ]
    }
  ]
}